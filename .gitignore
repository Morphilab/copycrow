# ========================================
# copycrow — .gitignore
# ========================================

# ================== Sensitive configuration ==================
copycrow.conf
copycrow.conf.migrated.*
*.env
*.env.*
.env

# ================== Runtime directories ==================
.mnt/*
!.mnt/.gitkeep

.locks/*
!.locks/.gitkeep

# ================== Logs ==================
logs/*
!logs/.gitkeep
*.log

# ================== Editor temporaries ==================
*.bak
*.swp
*.swo
*~
*.tmp
.DS_Store

# ================== Caches and junk ==================
__pycache__/
*.py[cod]
.cache/
.vscode/
.idea/

# ================== Generated artifacts ==================
*.tar.gz
*.zip
*.backup
/backup-*

# ================== Safety ==================
# Generic safety net: ignore files whose names contain common secret markers.
*secret*
*password*
*credential*
*token*
