# ========================================
# copycrow — .gitignore
# ========================================

# ================== Sensitive configuration ==================
copycrow.conf
*.env
*.env.*
.env

# ================== Local tooling (may contain credentials) ==================
opencode.json
.zcode/

# ================== Runtime directories ==================
.mnt/*
!.mnt/.gitkeep

.locks/*
!.locks/.gitkeep

# ================== Logs ==================
logs/*
!logs/.gitkeep
*.log

# ================== Editor temporaries ==================
*.bak
*.swp
*.swo
*~
*.tmp
.DS_Store

# ================== Caches and junk ==================
__pycache__/
*.py[cod]
.cache/
.vscode/
.idea/

# ================== Generated artifacts ==================
*.tar.gz
*.zip
*.backup
/backup-*

# ================== Safety ==================
# Ignore any file whose name contains "key", "secret", "password", etc.
*secret*
*password*
*credential*
*token*
